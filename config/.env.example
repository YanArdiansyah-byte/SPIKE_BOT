# Salin file ini ke config/.env lalu isi kunci kamu
# JANGAN commit config/.env ke GitHub!

# Wajib — main provider
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Opsional — provider cadangan (auto-fallback saat limit)
# GEMINI_API_KEY=xxxxx
# GROQ_API_KEY=xxxxx

# Opsional — generate gambar AI
# FAL_KEY=xxxxx

# Opsional — grup utama untuk broadcast jadwal otomatis
# GROUP_ID=628xxxx@g.us

# Opsional — nomor admin (pisahkan koma). Kosong = semua jadi admin
# ADMIN_NUMBERS=628111,628222